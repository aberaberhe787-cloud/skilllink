# ========== Required for Vercel ==========
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# PostgreSQL (required on Vercel — SQLite does not work on serverless)
# Free: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# ========== Optional OAuth ==========
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
