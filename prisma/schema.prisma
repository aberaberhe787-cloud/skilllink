// SkillLink Database Schema
// PostgreSQL recommended for production. SQLite works for local MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" for production
  url      = env("DATABASE_URL")
}

// ==================== AUTH (NextAuth / Auth.js) ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          String    @default("seeker") // "provider" | "seeker" | "admin"
  hashedPassword String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  providerProfile ProviderProfile?
  seekerJobs    Job[]     @relation("SeekerJobs")
  reviewsGiven  Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  trainingProgress TrainingProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProviderProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                 String?
  experienceYears     Int      @default(0)
  serviceRadiusKm     Int      @default(10)
  isVerified          Boolean  @default(false)
  verificationStatus  String   @default("pending")
  badges              String   @default("[]")
  rating              Float    @default(0)
  reviewCount         Int      @default(0)
  completionRate      Float    @default(100)
  responseTimeMinutes Int      @default(60)
  isAvailable         Boolean  @default(true)
  totalJobsCompleted  Int      @default(0)

  lat                 Float?
  lng                 Float?
  address             String?

  idDocumentUrl       String?
  certificateUrls     String   @default("[]")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  skills              ProviderSkill[]
  rates               ProviderRate[]
  jobs                Job[]    @relation("ProviderJobs")
}

model ProviderSkill {
  id         String @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   String

  @@unique([providerId, category])
}

model ProviderRate {
  id         String @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   String
  amount     Int

  @@unique([providerId, category])
}

model Job {
  id            String   @id @default(cuid())
  seekerId      String
  seeker        User     @relation("SeekerJobs", fields: [seekerId], references: [id])
  providerId    String?
  provider      ProviderProfile? @relation("ProviderJobs", fields: [providerId], references: [id])

  category      String
  title         String
  description   String
  status        String   @default("open")

  price         Int
  platformFee   Int
  providerPayout Int

  lat           Float?
  lng           Float?
  address       String?

  preferredTime String?
  aiMatchScore  Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  payment       Payment?
  reviews       Review[]
}

model Payment {
  id              String   @id @default(cuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id])

  amount          Int
  platformFee     Int
  providerAmount  Int

  status          String   @default("pending")
  provider        String?
  externalId      String?
  checkoutUrl     String?

  paidAt          DateTime?
  releasedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])

  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id])

  rating     Int
  comment    String?
  photos     String   @default("[]")

  createdAt  DateTime @default(now())

  @@unique([jobId, fromUserId])
}

model TrainingCourse {
  id             String   @id @default(cuid())
  title          String
  category       String
  level          String
  description    String?
  durationMinutes Int     @default(30)
  isFree         Boolean  @default(true)
  lessonsCount   Int      @default(1)
  contentUrl     String?

  createdAt      DateTime @default(now())
  progress       TrainingProgress[]
}

model TrainingProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      TrainingCourse @relation(fields: [courseId], references: [id])

  completed   Boolean  @default(false)
  quizScore   Int?
  badgeEarned String?
  completedAt DateTime?

  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
}
